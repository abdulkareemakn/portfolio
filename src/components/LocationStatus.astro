---
import Logo from "./Logo.astro";
import { MapPin } from "@lucide/astro";
---

<div class="status">
  <div class="avatar">
    <Logo />
    <span
      class="presence"
      title="Active in Lahore, Pakistan (PKT / UTC+5)"
      aria-hidden="true"></span>
  </div>

  <div class="status-text">
    <p class="place">
      <MapPin class="pin" />
      <span>Lahore, Pakistan</span>
      <span class="weather" data-weather></span>
    </p>
    <p class="time">
      <span data-clock>--:--:--</span>
      <span>PKT</span>
      <span data-tz-diff></span>
    </p>
  </div>
</div>

<script>
  const timezone = "Asia/Karachi";
  const clockEl = document.querySelector<HTMLElement>("[data-clock]");
  const tzDiffEl = document.querySelector<HTMLElement>("[data-tz-diff]");
  const weatherEl = document.querySelector<HTMLElement>("[data-weather]");

  // 1. Live clock
  const timeFormatter = new Intl.DateTimeFormat("en-GB", {
    timeZone: timezone,
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });

  function tick(): void {
    if (clockEl) {
      clockEl.textContent = timeFormatter.format(new Date());
    }
  }
  tick();
  setInterval(tick, 1000);

  // 2. How far ahead or behind the visitor Lahore is
  function updateTimezoneDifference(): void {
    if (!tzDiffEl) return;
    try {
      const now = new Date();
      const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";

      const getOffsetMinutes = (tzName: string) => {
        const parts = new Intl.DateTimeFormat("en-US", {
          timeZone: tzName,
          timeZoneName: "shortOffset",
        }).formatToParts(now);
        const val = parts.find((p) => p.type === "timeZoneName")?.value || "";
        const match = val.match(/(?:GMT|UTC)?([+-]\d+)(?::(\d+))?/);
        if (!match) return 0;
        const h = parseInt(match[1], 10);
        const m = match[2] ? parseInt(match[2], 10) : 0;
        return h * 60 + (h < 0 ? -m : m);
      };

      const userOffset = getOffsetMinutes(userTz);
      const lahoreOffset = 300; // UTC+5 in minutes
      const diffMins = lahoreOffset - userOffset;
      const diffHours = diffMins / 60;

      if (Math.abs(diffMins) < 15) {
        tzDiffEl.textContent = "";
      } else {
        const isAhead = diffMins > 0;
        const absH = Math.abs(diffHours);
        const formattedH = Number.isInteger(absH)
          ? `${absH}`
          : `${absH.toFixed(1)}`;
        tzDiffEl.textContent = `· ${formattedH}h ${isAhead ? "ahead of" : "behind"} you`;
      }
    } catch {
      tzDiffEl.textContent = "";
    }
  }
  updateTimezoneDifference();

  // 3. Open-Meteo weather
  const weatherLabels: Record<number, string> = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Rime fog",
    51: "Light drizzle",
    53: "Drizzle",
    55: "Heavy drizzle",
    61: "Light rain",
    63: "Rain",
    65: "Heavy rain",
    80: "Light showers",
    81: "Showers",
    95: "Thunderstorm",
  };

  fetch(
    "https://api.open-meteo.com/v1/forecast?latitude=31.5497&longitude=74.3436&current=temperature_2m,weather_code",
  )
    .then((res) => res.json())
    .then(
      (data: { current: { temperature_2m: number; weather_code: number } }) => {
        const temp = Math.round(data.current.temperature_2m);
        const label = weatherLabels[data.current.weather_code] ?? "Clear sky";
        if (weatherEl) {
          weatherEl.textContent = `${label} · ${temp}°C`;
        }
      },
    )
    .catch(() => {
      if (weatherEl) weatherEl.textContent = "";
    });
</script>

<style>
  .status {
    display: flex;
    align-items: center;
    gap: 1.0667rem;
  }

  .avatar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 9999px;
    background: var(--border);
    color: var(--text);
  }

  .avatar :global(svg) {
    width: 1.4667rem;
    height: 1.4667rem;
  }

  .presence {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 0.8667rem;
    height: 0.8667rem;
    border-radius: 9999px;
    background: var(--rose);
    border: 2px solid var(--bg);
  }

  .status-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .place {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.1rem 0.5333rem;
    line-height: 1.4667;
  }

  .place :global(.pin) {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }

  .weather,
  .time {
    color: var(--muted);
  }

  .time {
    display: flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8667rem;
    line-height: 1.3846;
    font-variant-numeric: tabular-nums;
  }
</style>
