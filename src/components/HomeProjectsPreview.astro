---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ayakPreview from "../assets/projects/ayak-preview.png";
import cursusPreview from "../assets/projects/cursus.png";

type PreviewProject = {
  name: string;
  title: string;
  summary: string;
  href: string;
  theme: "ayak" | "cursus";
  image: ImageMetadata;
  alt: string;
};

const projects: PreviewProject[] = [
  {
    name: "Ayak",
    title: "Edge-native ecommerce for handmade jewelry",
    summary:
      "Cloudflare Workers + D1 + R2 powering storefront, checkout, and order workflows.",
    href: "https://ayak.abdulkareemakn.workers.dev",
    theme: "ayak",
    image: ayakPreview,
    alt: "Ayak storefront dashboard preview",
  },
  {
    name: "Cursus",
    title: "Keep your academic life in order",
    summary:
      "TanStack Start + React on Cloudflare Workers, with D1 powering timetable sync, attendance, and grade tracking.",
    href: "https://getcursus.cc",
    theme: "cursus",
    image: cursusPreview,
    alt: "Cursus timetable dashboard preview",
  },
];
---

<section class="projects-preview" aria-labelledby="projects-preview-title">
  <div class="projects-heading">
    <h2 id="projects-preview-title">Selected Projects</h2>
    <a class="view-all" href="/projects">View all</a>
  </div>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <a class="project-link" href={project.href}>
          <article class={`project-card ${project.theme}`}>
            <p class="project-name">{project.name}</p>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-summary">{project.summary}</p>

            <div class="project-visual" aria-hidden="true">
              <Image
                class="project-preview-image"
                src={project.image}
                alt={project.alt}
                loading="lazy"
                decoding="async"
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 70vw"
              />
            </div>
          </article>
        </a>
      ))
    }
  </div>
</section>

<style>
  .projects-preview {
    margin: 2.5rem 0;
  }

  .projects-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
  }

  .view-all {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .view-all:hover,
  .view-all:focus-visible {
    color: var(--accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .project-link {
    color: inherit;
    text-decoration: none;
  }

  .project-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 1rem;
    min-height: clamp(24rem, 68vh, 38rem);
    border-radius: 1.15rem;
    padding: 1.4rem;
    color: var(--text);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .project-link:hover .project-card,
  .project-link:focus-visible .project-card {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
  }

  .project-card.ayak {
    background: #faf6f0;
    color: #17171a;
  }

  .project-card.cursus {
    background: #eaf5f6;
    color: #17171a;
  }

  .project-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .project-title {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .project-summary {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    opacity: 0.9;
  }

  .project-visual {
    border-radius: 0.9rem;
    overflow: hidden;
    border: 1px solid rgba(23, 23, 23, 0.14);
    background: rgba(255, 255, 255, 0.15);
    min-height: 12.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem;
  }

  .project-preview-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center top;
    border-radius: 0.6rem;
  }

  @media (max-width: 700px) {
    .project-card {
      min-height: auto;
      padding: 1rem;
    }
  }
</style>