---
const { username = "abdulkareemakn" } = Astro.props;
---

<div
  class="gh-contributions"
  data-username={username}
  aria-label="GitHub contribution chart for the past year"
>
  <div class="gh-card">
    <p class="gh-heading">GitHub Contributions</p>
    <div
      class="gh-scroll"
      tabindex="0"
      aria-label="Scrollable GitHub contribution chart"
    >
      <div class="gh-loading" aria-live="polite">Loading contributions…</div>
    </div>
  </div>
</div>

<script>
  (() => {
    const CELL_SIZE = 9;
    const CELL_GAP = 2;

    class GitHubContributions {
      constructor(container) {
        this.container = container;
        this.username = container.dataset.username;
        this.init();
      }

      async init() {
        try {
          const res = await fetch(
            `https://github-contributions-api.jogruber.de/v4/${this.username}?y=last`,
          );
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          this.render(data);
        } catch {
          const loading = this.container.querySelector(".gh-loading");
          if (loading) loading.textContent = "Failed to load contributions.";
        }
      }

      render(data) {
        const { contributions, total } = data;
        if (!contributions?.length) {
          const loading = this.container.querySelector(".gh-loading");
          if (loading) loading.textContent = "No contribution data.";
          return;
        }

        const svg = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "svg",
        );
        svg.setAttribute("role", "img");
        svg.setAttribute(
          "aria-label",
          `GitHub contributions: ${total?.lastYear ?? 0} in the last year`,
        );

        const dayPos = this.computePositions(contributions);

        const totalWeeks = dayPos.length > 0 ? Math.ceil(dayPos.length / 7) : 0;
        const width = totalWeeks * (CELL_SIZE + CELL_GAP);
        const headerH = 4;
        const footerH = 20;
        const height = 7 * (CELL_SIZE + CELL_GAP) + headerH + footerH;

        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
        svg.setAttribute("width", width);
        svg.setAttribute("height", height);

        // Cells
        for (let i = 0; i < dayPos.length; i++) {
          const d = dayPos[i];
          if (!d) continue;
          const week = Math.floor(i / 7);
          const day = i % 7;
          const x = week * (CELL_SIZE + CELL_GAP);
          const y = headerH + day * (CELL_SIZE + CELL_GAP);

          const rect = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "rect",
          );
          rect.setAttribute("x", x);
          rect.setAttribute("y", y);
          rect.setAttribute("width", CELL_SIZE);
          rect.setAttribute("height", CELL_SIZE);
          rect.setAttribute("rx", "2");
          rect.setAttribute("fill", this.getLevelColor(d.level));
          rect.dataset.count = d.count;
          rect.dataset.date = d.date;
          rect.dataset.level = d.level;

          svg.appendChild(rect);
        }

        // Footer: total count
        const totalText = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        totalText.setAttribute("x", 0);
        totalText.setAttribute("y", height - 2);
        totalText.setAttribute("font-family", "Vercetti, sans-serif");
        totalText.setAttribute("fill", "var(--muted)");
        totalText.setAttribute("font-size", "13");

        const totalStr = `${total?.lastYear ?? 0} contributions in the last year on `;
        const totalSpan = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "tspan",
        );
        totalSpan.textContent = totalStr;
        totalSpan.setAttribute("fill", "var(--muted)");
        totalSpan.setAttribute("font-family", "Vercetti, sans-serif");
        totalText.appendChild(totalSpan);

        const linkSpan = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "tspan",
        );
        const link = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "a",
        );
        link.setAttribute("href", `https://github.com/${this.username}`);
        link.setAttribute("target", "_blank");
        link.setAttribute("rel", "noopener");
        link.textContent = "GitHub";
        link.setAttribute("fill", "var(--accent)");
        link.setAttribute("font-family", "Vercetti, sans-serif");
        link.setAttribute("text-decoration", "underline");
        link.setAttribute("text-underline-offset", "2px");
        link.setAttribute("text-decoration-color", "var(--muted)");
        linkSpan.appendChild(link);
        totalText.appendChild(linkSpan);

        svg.appendChild(totalText);

        const card = this.container.querySelector(".gh-card");
        const loading = this.container.querySelector(".gh-loading");
        if (!card) return;
        if (loading) loading.remove();
        const scroll = card.querySelector(".gh-scroll");
        if (scroll) scroll.appendChild(svg);
      }

      computePositions(contributions) {
        const map = {};
        for (const c of contributions) {
          map[c.date] = c;
        }

        const result = [];
        const end = new Date();
        const start = new Date(end);
        start.setFullYear(start.getFullYear() - 1);
        start.setDate(start.getDate() + 1);

        const current = new Date(start);
        while (current <= end) {
          const key = current.toISOString().slice(0, 10);
          result.push(map[key] || { date: key, count: 0, level: 0 });
          current.setDate(current.getDate() + 1);
        }

        return result;
      }

      getLevelColor(level) {
        const isDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (isDark) {
          const colors = [
            "var(--border)",
            "#0e4429",
            "#006d32",
            "#26a641",
            "#39d353",
          ];
          return colors[level] || colors[0];
        }
        const colors = [
          "var(--border)",
          "#9be9a8",
          "#40c463",
          "#30a14e",
          "#216e39",
        ];
        return colors[level] || colors[0];
      }
    }

    const container = document.querySelector(".gh-contributions");
    if (container) {
      new GitHubContributions(container);
    }
  })();
</script>
