---
import Logo from "./Logo.astro";

/**
 * The top bar replaces the old sidebar. Each link has a hue and a hotkey;
 * the active page gets a 2px rule in its own hue. See DESIGN.md → Layout.
 */
const links = [
  { href: "/", label: "Home", key: "h", hue: "rose" },
  { href: "/about", label: "About", key: "a", hue: "rose" },
  { href: "/projects", label: "Projects", key: "p", hue: "blue" },
  { href: "/kit", label: "Kit", key: "k", hue: "blue" },
  { href: "/library", label: "Library", key: "l", hue: "yellow" },
  { href: "/training", label: "Training", key: "t", hue: "green" },
  {
    href: "https://abdulkareem.is-a.dev",
    label: "Blog",
    key: "b",
    hue: "purple",
    external: true,
  },
  { href: "/connect", label: "Connect", key: "c", hue: "rose" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="topbar">
  <div class="topbar-inner column">
    <a class="logo" href="/" aria-label="Abdul Kareem, home">
      <Logo />
    </a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      hidden
    >
      <span class="menu-label">Menu</span>
      <svg
        class="menu-icon"
        viewBox="0 0 14 10"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="bars" d="M1 1.5h12M1 8.5h12"></path>
        <path class="cross" d="M2 1l10 8M12 1 2 9"></path>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                class={`nav-link hue-${link.hue}`}
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                aria-keyshortcuts={link.key.toUpperCase()}
                data-hotkey={link.key}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener" : undefined}
              >
                <span class="nav-inner">
                  <kbd aria-hidden="true">{link.key}</kbd>
                  <span class="nav-label">{link.label}</span>
                  {link.external && (
                    <svg
                      class="nav-ext"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 9 9 3M4 3h5v5" />
                    </svg>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Hotkeys: press a link's key to follow it.
  document.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.repeat) return;

    const target = event.target;
    if (
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
    )
      return;

    const link = document.querySelector<HTMLAnchorElement>(
      `[data-hotkey="${event.key.toLowerCase()}"]`,
    );
    if (link) link.click();
  });

  // Phone menu. Without JavaScript the nav simply stays visible.
  const header = document.querySelector<HTMLElement>(".topbar");
  const button = header?.querySelector<HTMLButtonElement>(".menu-btn");
  if (header && button) {
    header.classList.add("has-menu");
    button.hidden = false;

    const set = (open: boolean) => {
      header.toggleAttribute("data-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.querySelector(".menu-label")!.textContent = open ? "Close" : "Menu";
    };

    button.addEventListener("click", () =>
      set(button.getAttribute("aria-expanded") !== "true"),
    );
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") set(false);
    });
  }
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: 3.7333rem;
    gap: 0.5rem 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    color: var(--text);
  }

  .logo:hover {
    color: var(--rose-ink);
  }

  .logo :global(svg) {
    width: 2.2667rem;
    height: 2.2667rem;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6667rem;
    height: 2.6667rem;
    padding: 0 1.0667rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.0667rem;
    cursor: pointer;
  }

  .menu-btn[hidden] {
    display: none;
  }

  .menu-icon {
    width: 0.9333rem;
    height: 0.6667rem;
  }

  .cross,
  .has-menu[data-open] .bars {
    display: none;
  }

  .has-menu[data-open] .cross {
    display: inline;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9333rem;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3.2rem;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.4667;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.3333rem;
    border-radius: 8px;
  }

  kbd {
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.2667rem;
    height: 1.2667rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
    color: var(--muted);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .nav-ext {
    width: 0.6667rem;
    height: 0.6667rem;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current="page"] {
    color: var(--hue-ink);
  }

  .nav-link[aria-current="page"] {
    color: var(--text);
  }

  .nav-link:hover kbd,
  .nav-link:focus-visible kbd,
  .nav-link[aria-current="page"] kbd {
    color: var(--hue-ink);
    border-color: color-mix(in srgb, var(--hue) 45%, transparent);
    background: color-mix(in srgb, var(--hue) var(--tint), transparent);
  }

  .nav-link:focus-visible {
    outline: none;
  }

  .nav-link:focus-visible .nav-inner {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--hue);
  }

  /* Desktop: one row, 72px tall, the active rule flush with the border. */
  @media (min-width: 720px) {
    .topbar-inner {
      flex-wrap: nowrap;
      height: var(--nav-height);
    }

    .nav-link {
      height: var(--nav-height);
    }

    .nav-link[aria-current="page"]::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: var(--hue);
    }

    .menu-btn {
      display: none;
    }
  }

  /* Keycaps only where a hardware keyboard is likely. */
  @media (min-width: 720px) and (hover: hover) and (pointer: fine) {
    kbd {
      display: inline-flex;
    }
  }

  /* Phone: logo plus a Menu button; the nav is a full-width sheet. */
  @media (max-width: 719.98px) {
    .topbar-inner {
      height: 3.7333rem;
    }

    .site-nav {
      width: 100%;
    }

    .has-menu .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .has-menu[data-open] .site-nav {
      display: block;
    }

    .site-nav ul {
      display: block;
    }

    .site-nav li + li {
      border-top: 1px solid var(--border);
    }

    .nav-link {
      min-height: 3.4667rem;
      padding: 0 var(--gutter);
      font-size: 1.4667rem;
      color: var(--text);
    }

    .nav-inner {
      gap: 0.9333rem;
    }

    .nav-inner::before {
      content: "";
      width: 0.6667rem;
      height: 0.6667rem;
      border-radius: 9999px;
      background: var(--hue);
    }

    .nav-link[aria-current="page"] {
      background: color-mix(in srgb, var(--hue) var(--tint), transparent);
      color: var(--hue-ink);
    }

    .nav-ext {
      width: 0.8em;
      height: 0.8em;
      color: var(--muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    kbd {
      transition: none;
    }
  }
</style>
