---
import { Icon } from "astro-icon/components";
import { CalendarDays, FileText, Mail } from "@lucide/astro";
import Pill from "./Pill.astro";
---

<div class="socials" role="group" aria-label="Find me online">
  <Pill
    hue="rose"
    size="md"
    solid
    href="https://cal.com/abdulkareem"
    data-cal-link="abdulkareem"
    data-cal-config='{"layout":"month_view"}'
  >
    <CalendarDays slot="icon" aria-hidden="true" />
    Book a call
  </Pill>
  <Pill hue="rose" href="/resume">
    <FileText slot="icon" aria-hidden="true" />
    Resume
  </Pill>
  <Pill hue="rose" href="mailto:abdulkareemakn@proton.me">
    <Mail slot="icon" aria-hidden="true" />
    Email
  </Pill>
  <Pill hue="rose" href="https://github.com/abdulkareemakn" external>
    <Icon slot="icon" name="simple-icons:github" />
    GitHub
  </Pill>
  <Pill
    hue="rose"
    href="https://www.linkedin.com/in/abdul-kareem-nasir/"
    external
  >
    <Icon slot="icon" name="simple-icons:linkedin" />
    LinkedIn
  </Pill>
  <Pill hue="rose" href="https://x.com/notabdulkareem" external>
    <Icon slot="icon" name="simple-icons:x" />
    X
  </Pill>
</div>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6667rem;
  }
</style>

<script is:inline>
  (function (C, A, L) {
    const push = (api, args) => api.q.push(args);
    const doc = C.document;
    C.Cal =
      C.Cal ||
      function () {
        const cal = C.Cal;
        const args = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          const script = doc.createElement("script");
          script.src = A;
          doc.head.appendChild(script);
          cal.loaded = true;
        }
        if (args[0] === L) {
          const api = function () {
            push(api, arguments);
          };
          const namespace = args[1];
          api.q = api.q || [];
          typeof namespace === "string"
            ? (cal.ns[namespace] = api) && push(api, args)
            : push(cal, args);
          return;
        }
        push(cal, args);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", { origin: "https://cal.com" });
</script>
