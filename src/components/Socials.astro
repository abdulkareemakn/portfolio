---
import { Icon } from "astro-icon/components";

interface Social {
  label: string;
  name: string;
  href: string;
  icon?: string;
  path?: string;
  target?: "_blank";
  cal?: boolean;
}

// Brand marks (X, GitHub, LinkedIn) rendered with astro-icon (simple-icons dataset).
// Mail envelope sourced from Heroicons (MIT) kept untouched as generic UI icon.
const socials: Social[] = [
  {
    label: "x formerly twitter",
    name: "twitter",
    href: "https://x.com/notabdulkareem",
    target: "_blank",
    icon: "simple-icons:x",
  },
  {
    label: "github",
    name: "github",
    href: "https://github.com/abdulkareemakn",
    target: "_blank",
    icon: "simple-icons:github",
  },
  {
    label: "linkedin",
    name: "linkedin",
    href: "https://www.linkedin.com/in/abdul-kareem-nasir/",
    target: "_blank",
    icon: "simple-icons:linkedin",
  },
  {
    label: "email",
    name: "email",
    href: "mailto:abdulkareemakn@proton.me",
    path: "M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67ZM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z",
  },
  {
    label: "book a call on calcom",
    name: "cal.com",
    href: "https://cal.com/abdulkareem",
    path: "M6.75 2.25v1.5m10.5-1.5v1.5M3.75 18V6.75a3 3 0 0 1 3-3h10.5a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3H6.75a3 3 0 0 1-3-3Zm0-9.75h16.5",
    cal: true,
  },
];
---

<div class="socials" aria-label="Find me online">
  {
    socials.map((s) => (
      <a
        class="social"
        href={s.href}
        target={s.target}
        rel={s.target === "_blank" ? "noreferrer" : undefined}
        aria-label={s.label}
        title={s.label}
        data-cal-link={s.cal ? "abdulkareem" : undefined}
        data-cal-config={s.cal ? '{"layout":"month_view"}' : undefined}
      >
        {s.icon ? (
          <Icon name={s.icon} />
        ) : (
          <svg viewBox="0 0 24 24" fill={s.cal ? "none" : "currentColor"} stroke={s.cal ? "currentColor" : undefined} stroke-width={s.cal ? "1.5" : undefined} aria-hidden="true">
            <path d={s.path} stroke-linecap={s.cal ? "round" : undefined} stroke-linejoin={s.cal ? "round" : undefined} />
          </svg>
        )}
        <span>{s.name}</span>
      </a>
    ))
  }
</div>

<script is:inline>
  (function (C, A, L) {
    const push = (api, args) => api.q.push(args);
    const doc = C.document;
    C.Cal = C.Cal || function () {
      const cal = C.Cal;
      const args = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        const script = doc.createElement("script");
        script.src = A;
        doc.head.appendChild(script);
        cal.loaded = true;
      }
      if (args[0] === L) {
        const api = function () { push(api, arguments); };
        const namespace = args[1];
        api.q = api.q || [];
        typeof namespace === "string" ? (cal.ns[namespace] = api) && push(api, args) : push(cal, args);
        return;
      }
      push(cal, args);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", { origin: "https://cal.com" });
</script>
