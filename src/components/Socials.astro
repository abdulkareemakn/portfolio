---
import { Icon } from "astro-icon/components";
import { RuneIcon } from "runeicons-astro";

interface Social {
  label: string;
  name: string;
  href: string;
  icon?: string;
  rune?: string;
  target?: "_blank";
  cal?: boolean;
}

// Brand marks (X, GitHub, LinkedIn, Cal.com) use astro-icon's simple-icons dataset.
// Generic UI icons (mail) come from RuneIcons.
const socials: Social[] = [
  {
    label: "x formerly twitter",
    name: "twitter",
    href: "https://x.com/notabdulkareem",
    target: "_blank",
    icon: "simple-icons:x",
  },
  {
    label: "github",
    name: "github",
    href: "https://github.com/abdulkareemakn",
    target: "_blank",
    icon: "simple-icons:github",
  },
  {
    label: "linkedin",
    name: "linkedin",
    href: "https://www.linkedin.com/in/abdul-kareem-nasir/",
    target: "_blank",
    icon: "simple-icons:linkedin",
  },
  {
    label: "email",
    name: "email",
    href: "mailto:abdulkareemakn@proton.me",
    rune: "messaging-mail",
  },
  {
    label: "book a call on calcom",
    name: "cal.com",
    href: "https://cal.com/abdulkareem",
    icon: "simple-icons:caldotcom",
    cal: true,
  },
];
---

<div class="socials" aria-label="Find me online">
  {
    socials.map((s) => (
      <a
        class="social"
        href={s.href}
        target={s.target}
        rel={s.target === "_blank" ? "noreferrer" : undefined}
        aria-label={s.label}
        title={s.label}
        data-cal-link={s.cal ? "abdulkareem" : undefined}
        data-cal-config={s.cal ? '{"layout":"month_view"}' : undefined}
      >
        {s.icon ? (
          <Icon name={s.icon} />
        ) : (
          <RuneIcon name={s.rune ?? "messaging-mail"} size={18} />
        )}
        <span>{s.name}</span>
      </a>
    ))
  }
</div>

<script is:inline>
  (function (C, A, L) {
    const push = (api, args) => api.q.push(args);
    const doc = C.document;
    C.Cal =
      C.Cal ||
      function () {
        const cal = C.Cal;
        const args = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          const script = doc.createElement("script");
          script.src = A;
          doc.head.appendChild(script);
          cal.loaded = true;
        }
        if (args[0] === L) {
          const api = function () {
            push(api, arguments);
          };
          const namespace = args[1];
          api.q = api.q || [];
          typeof namespace === "string"
            ? (cal.ns[namespace] = api) && push(api, args)
            : push(cal, args);
          return;
        }
        push(cal, args);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", { origin: "https://cal.com" });
</script>
