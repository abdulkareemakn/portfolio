---
interface Props {
  text: string;
  /** Who said it, and where. */
  cite?: string;
}

const { text, cite } = Astro.props;
---

<figure class="quote">
  <span class="mark" aria-hidden="true">“</span>
  <div class="body">
    <blockquote>{text}</blockquote>
    {cite && <figcaption class="label">{cite}</figcaption>}
  </div>
</figure>

<style>
  .quote {
    display: flex;
    gap: 1.3333rem;
    margin: 0;
    padding: 1.8667rem 2rem 1.8667rem 1.8667rem;
    border-radius: 14px;
    border: 1px solid var(--border);
  }

  .mark {
    flex-shrink: 0;
    width: 2.4rem;
    font-family: var(--font-serif);
    font-size: 5.8667rem;
    line-height: 4.8rem;
    color: var(--hue, var(--rose));
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.9333rem;
    min-width: 0;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.4667rem, 4vw, 1.8667rem);
    line-height: 1.3571;
    text-wrap: pretty;
  }

  @media (max-width: 480px) {
    .quote {
      padding: 1.2rem;
      gap: 0.6667rem;
    }

    .mark {
      width: 1.6rem;
      font-size: 4rem;
      line-height: 3.2rem;
    }
  }
</style>
