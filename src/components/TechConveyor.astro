---
import { Icon } from "astro-icon/components";

const iconSlugs: Record<string, string> = {
  TypeScript: "simple-icons:typescript",
  Astro: "simple-icons:astro",
  React: "simple-icons:react",
  Vue: "simple-icons:vuedotjs",
  "Tailwind CSS": "simple-icons:tailwindcss",
  Hono: "simple-icons:hono",
  "TanStack Start": "simple-icons:tanstack",
  Vite: "simple-icons:vite",
  Python: "simple-icons:python",
  FastAPI: "simple-icons:fastapi",
  Cloudflare: "simple-icons:cloudflare",
  Docker: "simple-icons:docker",
  PostgreSQL: "simple-icons:postgresql",
  SQLite: "simple-icons:sqlite",
  Drizzle: "simple-icons:drizzle",
  Caddy: "simple-icons:caddy",
};

const rows = [
  [
    "TypeScript",
    "Astro",
    "React",
    "Vue",
    "Tailwind CSS",
    "Hono",
    "TanStack Start",
    "Vite",
  ],
  [
    "Python",
    "FastAPI",
    "Cloudflare",
    "Docker",
    "PostgreSQL",
    "SQLite",
    "Drizzle",
    "Caddy",
  ],
];
---

<div class="work">
  <h2 class="work-title">What I work with</h2>
  {
    rows.map((row, i) => (
      <div class="marquee" style={`--duration: ${i === 0 ? "30s" : "25s"}`}>
        <div class="marquee-copy">
          {row.map((name) => (
            <span class="item">
              <span class="item-icon">
                <Icon name={iconSlugs[name]} />
              </span>
              {name}
            </span>
          ))}
        </div>
        <div class="marquee-copy" aria-hidden="true">
          {row.map((name) => (
            <span class="item">
              <span class="item-icon">
                <Icon name={iconSlugs[name]} />
              </span>
              {name}
            </span>
          ))}
        </div>
        <div class="marquee-copy" aria-hidden="true">
          {row.map((name) => (
            <span class="item">
              <span class="item-icon">
                <Icon name={iconSlugs[name]} />
              </span>
              {name}
            </span>
          ))}
        </div>
        <span class="fade fade-left" aria-hidden="true" />
        <span class="fade fade-right" aria-hidden="true" />
      </div>
    ))
  }
</div>
