---
import Logo from "./Logo.astro";
---

<aside class="sidebar">
  <a class="logo-link" href="/" aria-label="Abdul Kareem">
    <Logo />
  </a>
  <nav class="nav">
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/projects">Projects</a>
    <a href="/resume">Resume</a>
    <a href="/kit">Kit</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Links</a>
  </nav>
</aside>

<style>
  .logo-link {
    display: block;
    margin-bottom: 2rem;
    color: #000;
  }

  :root[data-theme="dark"] .logo-link {
    color: #fff;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .logo-link {
      color: #fff;
    }
  }

  .logo-link:hover {
    color: var(--accent);
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
  }

  .nav a {
    color: var(--text);
    text-decoration: none;
    opacity: 0.65;
    transition: opacity 0.15s ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    opacity: 1;
    color: var(--accent);
  }
</style>
