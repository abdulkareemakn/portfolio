---
import Logo from "./Logo.astro";
import { Monitor, Moon, Sun } from "@lucide/astro";
---

<aside class="sidebar">
  <a class="logo-link" href="/" aria-label="Abdul Kareem">
    <Logo />
  </a>
  <nav class="nav">
    <a href="/" data-hotkey="h" aria-keyshortcuts="H"
      ><span class="nav-hotkey" aria-hidden="true">[h]</span> Home</a
    >
    <a href="/about" data-hotkey="a" aria-keyshortcuts="A"
      ><span class="nav-hotkey" aria-hidden="true">[a]</span> About</a
    >
    <a href="/projects" data-hotkey="p" aria-keyshortcuts="P"
      ><span class="nav-hotkey" aria-hidden="true">[p]</span> Projects</a
    >
    <a href="/kit" data-hotkey="k" aria-keyshortcuts="K"
      ><span class="nav-hotkey" aria-hidden="true">[k]</span> Kit</a
    >
    <a href="/library" data-hotkey="l" aria-keyshortcuts="L"
      ><span class="nav-hotkey" aria-hidden="true">[l]</span> Library</a
    >
    <a
      href="https://abdulkareem.is-a.dev"
      target="_blank"
      rel="noopener"
      data-hotkey="b"
      aria-keyshortcuts="B"
      ><span class="nav-hotkey" aria-hidden="true">[b]</span> Blog</a
    >
    <a href="/connect" data-hotkey="c" aria-keyshortcuts="C"
      ><span class="nav-hotkey" aria-hidden="true">[c]</span> Connect</a
    >
  </nav>
  <button class="theme-toggle" type="button" aria-label="Switch theme">
    <Sun class="theme-icon theme-icon-light" aria-hidden="true" />
    <Moon class="theme-icon theme-icon-dark" aria-hidden="true" />
    <Monitor class="theme-icon theme-icon-system" aria-hidden="true" />
  </button>
</aside>

<script>
  const toggle = document.querySelector(".theme-toggle");
  const themes = ["system", "ocean", "dark-graphite"];
  const themeNames: Record<string, string> = {
    system: "System",
    ocean: "Ocean Blue",
    "dark-graphite": "Graphite",
  };

  if (toggle) {
    const syncToggle = () => {
      const current = document.documentElement.dataset.theme ?? "system";
      const next = themes[(themes.indexOf(current) + 1) % themes.length];
      toggle.setAttribute(
        "aria-label",
        `Current theme: ${themeNames[current]}. Switch to ${themeNames[next]}`,
      );
    };

    syncToggle();
    toggle.addEventListener("click", () => {
      const current = document.documentElement.dataset.theme ?? "system";
      const nextTheme = themes[(themes.indexOf(current) + 1) % themes.length];
      if (nextTheme === "system") delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = nextTheme;
      try {
        if (nextTheme === "system") localStorage.removeItem("theme");
        else localStorage.setItem("theme", nextTheme);
      } catch {}
      syncToggle();
      document.dispatchEvent(new Event("themechange"));
    });
  }

  document.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.repeat) return;

    const target = event.target;
    if (
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
    )
      return;

    const link = document.querySelector<HTMLAnchorElement>(
      `[data-hotkey="${event.key.toLowerCase()}"]`,
    );
    if (link) link.click();
  });
</script>
