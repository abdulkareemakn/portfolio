---
import Layout from "../layouts/Layout.astro";
import Quote from "../components/Quote.astro";
import { library, type Entry } from "../data/library";

const shelves: { id: string; title: string; entries: Entry[] }[] = [
  { id: "reading", title: "Reading now", entries: library.reading },
  { id: "books", title: "Books", entries: library.books },
  { id: "shows", title: "Shows", entries: library.shows },
].filter((shelf) => shelf.entries.length > 0);
---

<Layout
  title="Library — Abdul Kareem"
  description="The books and shows Abdul Kareem is reading and watching."
  hue="yellow"
>
  <div class="stack">
    <header class="head">
      <h1 class="page-title">Library</h1>
      <Quote text={library.quote.text} cite={library.quote.cite} />
    </header>

    {
      shelves.map((shelf) => (
        <section aria-labelledby={`${shelf.id}-title`}>
          <h2 class="section-title" id={`${shelf.id}-title`}>
            {shelf.title}
          </h2>
          <ul class="entries">
            {shelf.entries.map((entry) => (
              <li>
                <span class="title">{entry.title}</span>
                {entry.by && <span class="by">{entry.by}</span>}
                {entry.note && <span class="note">{entry.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .entries {
    list-style: none;
    margin: 1.3333rem 0 0;
    padding: 0;
  }

  .entries li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .entries li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1.7333rem;
    line-height: 1.2308;
    color: var(--hue-ink);
  }

  .by,
  .note {
    color: var(--muted);
  }
</style>
