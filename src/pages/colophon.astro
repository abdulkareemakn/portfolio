---
import Layout from "../layouts/Layout.astro";

// Each family has one job on this site. The role is the "why".
const families = [
  {
    name: "Hedvig Letters Serif",
    css: "var(--font-serif)",
    role: "Headings, the nav and quotes. A serif with an optical-size axis, so large type gets finer detail and small type stays sturdy.",
    sample: "Abdul Kareem",
    size: "clamp(2.2rem, 7vw, 3.4667rem)",
  },
  {
    name: "Vercetti",
    css: "var(--font-body)",
    role: "Body text, descriptions and pill labels. A plain grotesque that stays out of the way of the serif.",
    sample: "Software engineering student and freelance developer in Lahore.",
    size: "1.4rem",
  },
  {
    name: "0xProto",
    css: "var(--font-mono)",
    role: "Hotkeys, labels and numbers. A programmer's monospace, used small and in capitals so it reads as metadata.",
    sample: "h a p k l t b c · 14:32:08 PKT",
    size: "1.2rem",
  },
  {
    name: "Noto Nastaliq Urdu",
    css: "var(--font-urdu)",
    role: "His name in Urdu, and nowhere else. It needs a tall line so its long strokes never touch the line below.",
    sample: "عبدالکریم",
    size: "clamp(2.4rem, 8vw, 3.8rem)",
    rtl: true,
  },
];
---

<Layout
  title="Colophon — Abdul Kareem"
  description="The typefaces and tools behind this site, and why each one is here."
>
  <article class="colophon">
    <header class="head">
      <h1 class="page-title">Colophon</h1>
      <p class="lead">
        Four typefaces, each with one job. Hierarchy comes from family, size
        and colour, never from faking a bold.
      </p>
    </header>

    <ul class="specimens">
      {
        families.map((f) => (
          <li>
            <p class="label">{f.name}</p>
            <p
              class="sample"
              style={`font-family:${f.css};font-size:${f.size}`}
              dir={f.rtl ? "rtl" : undefined}
              lang={f.rtl ? "ur" : undefined}
            >
              {f.sample}
            </p>
            <p class="role">{f.role}</p>
          </li>
        ))
      }
    </ul>

    <p class="foot">
      The site is static <a class="text-link" href="https://astro.build">Astro</a>
      with plain CSS. Colours are Monokai Pro: Filter Sun by day, Filter
      Spectrum at night. Documents elsewhere are written in <a
        class="text-link"
        href="https://typst.app">Typst</a
      >.
    </p>
  </article>
</Layout>

<style>
  .colophon {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 38rem;
  }

  .specimens {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .specimens li {
    display: flex;
    flex-direction: column;
    gap: 0.6667rem;
    padding: 1.8667rem 0;
    border-top: 1px solid var(--border);
  }

  .specimens li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .sample {
    line-height: 1.5;
    color: var(--text);
  }

  .role {
    max-width: 36rem;
    color: var(--muted);
  }

  .foot {
    max-width: 36rem;
    color: var(--muted);
  }
</style>
