---
import Layout from "../layouts/Layout.astro";
import Pill from "../components/Pill.astro";
import { training } from "../data/training";

const { bench, split, weightTrend, sugarFreeSince } = training;

const benchPercent =
  bench.currentKg === null
    ? null
    : Math.min(100, Math.round((bench.currentKg / bench.goalKg) * 100));

// Whole days since the diet began, counted in Lahore time.
const streakDays = sugarFreeSince
  ? Math.max(
      0,
      Math.floor(
        (Date.now() - new Date(`${sugarFreeSince}T00:00:00+05:00`).getTime()) /
          86_400_000,
      ),
    )
  : null;

// Weight trend as a line, scaled to its own range.
const trend = (() => {
  if (weightTrend.length < 2) return null;
  const w = 320;
  const h = 72;
  const pad = 6;
  const values = weightTrend.map((p) => p.changeKg);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;
  const points = weightTrend.map((p, i) => {
    const x = pad + (i / (weightTrend.length - 1)) * (w - 2 * pad);
    const y = pad + ((max - p.changeKg) / span) * (h - 2 * pad);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const last = values[values.length - 1];
  return { w, h, points: points.join(" "), last };
})();
---

<Layout
  title="Training — Abdul Kareem"
  description="Abdul Kareem's lifting: a six-day split, a 100 kg bench goal and a no-sugar streak."
  hue="green"
>
  <div class="stack">
    <header class="head">
      <h1 class="page-title">Training</h1>
      <p class="lead">
        About four months into lifting, building a six-day split, and chasing a
        100 kg bench. Biceps get the minimum I can get away with.
      </p>
      <div class="pills">
        <Pill hue="green" icon="🏋️">Bench → {bench.goalKg} kg</Pill>
        <Pill
          hue="green"
          icon="📱"
          href="https://hevy.com/profile/abdulkareemakn"
          external>Workouts on Hevy</Pill
        >
      </div>
    </header>

    {
      benchPercent !== null && (
        <section aria-labelledby="bench-title">
          <h2 class="section-title" id="bench-title">Bench</h2>
          <div class="bench">
            <div
              class="bar"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax={bench.goalKg}
              aria-valuenow={bench.currentKg}
              aria-label="Bench press progress toward the goal"
            >
              <span class="fill" style={`width:${benchPercent}%`} />
            </div>
            <p class="figure">
              <span class="num">{bench.currentKg} kg</span>
              <span class="of">of {bench.goalKg} kg</span>
            </p>
          </div>
        </section>
      )
    }

    {
      split.length > 0 && (
        <section aria-labelledby="split-title">
          <h2 class="section-title" id="split-title">The split</h2>
          <ol class="split">
            {split.map((d) => (
              <li>
                <span class="day label">{d.day}</span>
                <span class="focus">{d.focus}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      trend && (
        <section aria-labelledby="trend-title">
          <h2 class="section-title" id="trend-title">Weight, as a trend</h2>
          <svg
            class="trend"
            viewBox={`0 0 ${trend.w} ${trend.h}`}
            role="img"
            aria-label={`Weight change since starting: ${trend.last > 0 ? "+" : ""}${trend.last} kg`}
          >
            <polyline
              points={trend.points}
              fill="none"
              stroke="var(--hue)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <p class="figure">
            <span class="num">
              {trend.last > 0 ? "+" : ""}
              {trend.last} kg
            </span>
            <span class="of">since the start</span>
          </p>
        </section>
      )
    }

    {
      streakDays !== null && sugarFreeSince && (
        <section aria-labelledby="sugar-title">
          <h2 class="section-title" id="sugar-title">No sugar</h2>
          <p class="figure">
            <span class="num" data-streak={sugarFreeSince}>
              {streakDays} {streakDays === 1 ? "day" : "days"}
            </span>
            <span class="of">without it, doodh soda included</span>
          </p>
        </section>
      )
    }
  </div>
</Layout>

<script>
  // Keep the streak current between builds.
  const el = document.querySelector<HTMLElement>("[data-streak]");
  if (el?.dataset.streak) {
    const start = new Date(`${el.dataset.streak}T00:00:00+05:00`).getTime();
    const days = Math.max(0, Math.floor((Date.now() - start) / 86_400_000));
    el.textContent = `${days} ${days === 1 ? "day" : "days"}`;
  }
</script>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 1.3333rem;
    max-width: 40rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6667rem;
  }

  section > h2 {
    margin-bottom: 1.3333rem;
  }

  .bar {
    height: 0.8rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--hue) var(--tint), var(--bg));
    border: 1px solid color-mix(in srgb, var(--hue) var(--line), var(--bg));
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: var(--hue);
  }

  .figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    margin-top: 0.8rem;
  }

  .num {
    font-family: var(--font-serif);
    font-size: 1.8667rem;
    line-height: 1.2143;
    color: var(--hue-ink);
  }

  .of {
    color: var(--muted);
  }

  .split {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .split li {
    display: flex;
    align-items: baseline;
    gap: 1.3333rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--border);
  }

  .split li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .day {
    width: 3.2rem;
    flex-shrink: 0;
  }

  .trend {
    display: block;
    width: min(100%, 22rem);
    height: auto;
  }
</style>
