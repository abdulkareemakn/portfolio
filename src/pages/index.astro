---
import Layout from "../layouts/Layout.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import Socials from "../components/Socials.astro";
---

<Layout title="Abdul Kareem — Portfolio">
  <section class="intro">
    <h1 class="headline">
      Abdul Kareem <span class="urdu" lang="ur" dir="rtl">عبد الكريم</span> <span class="ipa" lang="und-fonipa">[ʕab.dʊl ka'riːm]</span>
    </h1>
    <p class="profession">Software Engineer</p>
    <p class="tagline">
      I'm building <a href="https://ayak.abdulkareemakn.workers.dev">Ayak</a>, a handmade jewelry
      ecommerce platform, and <a href="https://orbit-egw.pages.dev">Orbit</a>, an attendance
      tracker for university courses.
    </p>
  </section>

  <div class="status-block">
    <div class="avatar" aria-hidden="true"></div>
    <div class="status-text">
      <span>▶ Currently Reading: <strong>A Clash of Kings</strong></span>
      <span>◆ Chess rating on Lichess: <strong data-lichess>1219</strong></span>
      <span>◇ <strong data-aur>2</strong> packages maintained on the AUR</span>
    </div>
  </div>

  <script>
    async function hydrateStatus() {
      const lichessEl = document.querySelector("[data-lichess]");
      if (lichessEl) {
        try {
          const res = await fetch(
            "https://lichess.org/api/user/Abdul_Kareem1",
          );
          const user = await res.json();
          lichessEl.textContent = String(user.perfs.rapid.rating);
        } catch { }
      }

      const aurEl = document.querySelector("[data-aur]");
      if (aurEl) {
        try {
          const res = await fetch(
            "https://aur.archlinux.org/rpc/v5/search?by=maintainer&arg=tmtaxman",
          );
          const data = await res.json();
          aurEl.textContent = String(data.resultcount);
        } catch { }
      }
    }
    hydrateStatus();
  </script>

  <div class="home-socials">
    <Socials />
  </div>

  <GitHubContributions username="abdulkareemakn" />
</Layout>

<style>
  .home-socials {
    margin-top: 2.5rem;
  }
</style>
