---
import Layout from "../layouts/Layout.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import { RuneIcon } from "runeicons-astro";
import linkedinSvg from "../assets/icons/linkedin.svg?raw";
---

<Layout
  title="Abdul Kareem — Portfolio"
  description="Abdul Kareem is a Software Engineer building Cursus, focusing on full-stack web applications, Cloudflare Workers, and open-source tooling."
>
  <section class="intro">
    <h1 class="headline">
      <span class="name-line">
        Abdul Kareem <span class="name-separator" aria-hidden="true">·</span>
        <span class="urdu" lang="ur" dir="rtl">عبدالکریم</span>
      </span>
      <span class="ipa" lang="und-fonipa">[ʕab.dʊl ka'riːm]</span>
    </h1>
    <p class="tagline">
      <span class="tagline-line">
        Hi. I'm Abdul Kareem, a software engineer based in Pakistan. I like
        making clean interfaces, contributing to open-source software and
        hosting my own applications and data.
      </span>
      <span class="tagline-line">
        I play chess, watch football and read books.
      </span>
      <span class="tagline-line">
        I'm currently building <a href="https://getcursus.cc">Cursus</a>, a
        timetable sync tool for university students.
      </span>
      <span class="tagline-line reach-out">
        You can reach out to me on{" "}
        <a
          href="https://www.linkedin.com/in/abdul-kareem-nasir/"
          target="_blank"
          rel="noreferrer"><Fragment set:html={linkedinSvg} />LinkedIn</a
        >{" "}
        or{" "}
        <a href="mailto:abdulkareemakn@proton.me"
          ><RuneIcon name="messaging-mail" size={16} />Email</a
        >{" "}
        or schedule a call on{" "}
        <a href="https://cal.com/abdulkareem" target="_blank" rel="noreferrer"
          >Cal.com</a
        >.
      </span>
    </p>
  </section>

  <GitHubContributions username="abdulkareemakn" />
</Layout>
