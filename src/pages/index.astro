---
import Layout from "../layouts/Layout.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import { RuneIcon } from "runeicons-astro";
import linkedinSvg from "../assets/icons/linkedin.svg?raw";

const linkClass =
  "text-text underline decoration-muted underline-offset-[3px] hover:text-accent hover:decoration-accent focus-visible:text-accent focus-visible:decoration-accent";
---

<Layout
  title="Abdul Kareem — Portfolio"
  description="Abdul Kareem is a Software Engineer building Cursus, focusing on full-stack web applications, Cloudflare Workers, and open-source tooling."
>
  <section>
    <h1 class="mb-6 font-serif text-[clamp(2rem,5vw,2.5rem)] leading-none font-bold">
      <span class="block">
        Abdul Kareem{" "}
        <span class="mx-1 text-text opacity-40" aria-hidden="true">
          ·
        </span>
        <span class="pe-3 font-urdu font-normal text-muted" lang="ur" dir="rtl">
          عبدالکریم
        </span>
      </span>
      <span
        class="mt-[0.35em] block font-sans text-[0.5em] leading-[1.2] whitespace-nowrap text-muted"
        lang="und-fonipa"
      >
        [ʕab.dʊl ka'riːm]
      </span>
    </h1>
    <p class="mb-10 text-[1.15rem] leading-[1.6] text-text [&>span+span]:mt-3">
      <span class="block">
        Hi. I'm Abdul Kareem, a software engineer based in Pakistan. I like
        making clean interfaces, contributing to open-source software and
        hosting my own applications and data.
      </span>
      <span class="block"> I play chess, watch football and read books. </span>
      <span class="block">
        I'm currently building
        <a class={linkClass} href="https://getcursus.cc">
          Cursus
        </a>
        , a timetable sync tool for university students.
      </span>
      <span class="block">
        You can reach out to me on{" "}
        <a
          class={`${linkClass} [&_svg]:mr-[0.3rem] [&_svg]:inline [&_svg]:size-[1.15em] [&_svg]:align-[-0.3em]`}
          href="https://www.linkedin.com/in/abdul-kareem-nasir/"
          target="_blank"
          rel="noreferrer"
        >
          <Fragment set:html={linkedinSvg} />
          LinkedIn
        </a>{" "}
        or{" "}
        <a
          class={`${linkClass} [&_svg]:mr-[0.3rem] [&_svg]:inline [&_svg]:size-[1.15em] [&_svg]:align-[-0.3em]`}
          href="mailto:abdulkareemakn@proton.me"
        >
          <RuneIcon name="messaging-mail" size={16} />
          Email
        </a>{" "}
        or schedule a call on{" "}
        <a
          class={linkClass}
          href="https://cal.com/abdulkareem"
          target="_blank"
          rel="noreferrer"
        >
          Cal.com
        </a>
        .
      </span>
    </p>
  </section>

  <GitHubContributions username="abdulkareemakn" />
</Layout>
