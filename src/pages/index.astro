---
import Layout from "../layouts/Layout.astro";
import LocationStatus from "../components/LocationStatus.astro";
import { CalendarDays } from "@lucide/astro";
import TechConveyor from "../components/TechConveyor.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import HomeProjectsPreview from "../components/HomeProjectsPreview.astro";
import Socials from "../components/Socials.astro";
---

<Layout
  title="Abdul Kareem — Portfolio"
  description="Abdul Kareem is a Software Engineer building Ayak and Orbit, focusing on full-stack web applications, Cloudflare Workers, and open-source tooling."
>
  <section class="intro">
    <h1 class="headline">
      <span class="name-line">
        Abdul Kareem <span class="name-separator" aria-hidden="true">·</span>
        <span class="urdu" lang="ur" dir="rtl">عبدالکریم</span>
      </span>
      <span class="ipa" lang="und-fonipa">[ʕab.dʊl ka'riːm]</span>
    </h1>
    <p class="profession">Software Engineer</p>
    <p class="tagline">
      I'm building <a href="https://ayak.abdulkareemakn.workers.dev">Ayak</a>, a
      handmade jewelry ecommerce platform, and <a
        href="https://orbit-egw.pages.dev">Orbit</a
      >, an attendance tracker for university courses.
    </p>
  </section>

  <LocationStatus />

  <a class="book-call" href="https://cal.com/abdulkareem" target="_blank" rel="noreferrer">
    <CalendarDays class="book-call-icon" />
    Book a call
  </a>

  <HomeProjectsPreview />

  <TechConveyor />

  <div class="home-socials">
    <Socials />
  </div>

  <GitHubContributions username="abdulkareemakn" />
</Layout>
