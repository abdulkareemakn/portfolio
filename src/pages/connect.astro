---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight } from "@lucide/astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="Connect — Abdul Kareem"
  description="Connect with Abdul Kareem on GitHub, LinkedIn, X, Spotify, Discord, Lichess, Hevy, and the AUR. Find social links, projects, and contact info."
>
  <article class="connect">
    <h1 class="connect-title">Connect</h1>

    <ul class="links-grid">
      <li>
        <a
          class="link-item"
          href="https://github.com/abdulkareemakn"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:github" class="icon" />
            GitHub
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://aur.archlinux.org/account/tmtaxman"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:archlinux" class="icon" />
            AUR
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://www.linkedin.com/in/abdul-kareem-nasir/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:linkedin" class="icon" />
            LinkedIn
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://x.com/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:x" class="icon" />
            X (Twitter)
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://open.spotify.com"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:spotify" class="icon" />
            Spotify
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://hevy.com"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:hevy" class="icon" />
            Hevy
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://discord.com"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:discord" class="icon" />
            Discord
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
      <li>
        <a
          class="link-item"
          href="https://lichess.org"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:lichess" class="icon" />
            Lichess
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
    </ul>
  </article>
</Layout>
