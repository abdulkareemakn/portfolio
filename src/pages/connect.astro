---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight, KeyRound, Mail } from "@lucide/astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="Connect — Abdul Kareem"
  description="Connect with Abdul Kareem on GitHub, LinkedIn, X, Spotify, Discord, Lichess, Hevy, and the AUR. Find social links, projects, and contact info."
>
  <article class="connect">
    <h1 class="connect-title">Connect</h1>

    <div class="contact-card">
      <a
        class="contact-row"
        href="mailto:abdulkareemakn@proton.me"
        target="_blank"
        rel="noreferrer"
      >
        <span class="link-label">
          <Mail class="icon" />
          Email
        </span>
        <ArrowUpRight class="arrow" />
      </a>

      <a class="contact-row contact-row--pgp" href="/pgp.asc" target="_blank" rel="noreferrer">
        <span class="link-label">
          <KeyRound class="icon" />
          <span class="link-stack">
            PGP key
            <span class="link-fingerprint">36D4 7302 992E B464 A582 7601 A942 864C C3B0 172F</span>
          </span>
        </span>
        <ArrowUpRight class="arrow" />
      </a>
    </div>

    <ul class="links-grid">
      <li>
        <a
          class="link-item"
          href="https://github.com/abdulkareemakn"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:github" class="icon" />
            GitHub
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>

      <li>
        <a
          class="link-item"
          href="https://aur.archlinux.org/account/tmtaxman"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:archlinux" class="icon" />
            AUR
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>

      <li>
        <a
          class="link-item"
          href="https://www.linkedin.com/in/abdul-kareem-nasir/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:linkedin" class="icon" />
            LinkedIn
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>

      <li>
        <a
          class="link-item"
          href="https://x.com/notabdulkareem"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:x" class="icon" />
            X (Twitter)
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>

      <li>
        <a
          class="link-item"
          href="https://open.spotify.com/user/vaa5i5twowfp79bewq0h5j47h"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:spotify" class="icon" />
            Spotify
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>

      <li>
        <a
          class="link-item"
          href="https://hevy.com/profile/abdulkareemakn"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:hevy" class="icon" />
            Hevy
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>

      <li>
        <div class="link-item link-item--static">
          <span class="link-label">
            <Icon name="simple-icons:discord" class="icon" />
            Discord
          </span>
          <span class="link-value">@tmtaxman</span>
        </div>
      </li>

      <li>
        <a
          class="link-item"
          href="https://lichess.org/@/Abdul_Kareem1"
          target="_blank"
          rel="noreferrer"
        >
          <span class="link-label">
            <Icon name="simple-icons:lichess" class="icon" />
            Lichess
          </span>
          <ArrowUpRight class="arrow" />
        </a>
      </li>
    </ul>
  </article>
</Layout>
