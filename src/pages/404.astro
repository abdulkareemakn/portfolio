---
import Layout from "../layouts/Layout.astro";
import Pill from "../components/Pill.astro";
---

<Layout
  title="404 — Abdul Kareem"
  description="The page you're looking for can't be found."
  noindex={true}
>
  <div class="drs">
    <div class="screen" role="group" aria-label="Third umpire decision review">
      <header class="strip">
        <span class="label">Decision review</span>
        <span class="label">Third umpire</span>
      </header>

      <div class="stage">
        <div class="reviewing" aria-hidden="true">
          <svg class="stumps" viewBox="0 0 120 90" fill="none">
            <path class="track" d="M4 8 C40 2 70 30 92 62" />
            <g class="wood">
              <path d="M82 70v-26M92 70v-26M102 70v-26" />
              <path d="M84 41h8M94 41h8" />
            </g>
            <circle class="ball" cx="4" cy="8" r="3.5" />
          </svg>
          <p class="status">
            Reviewing<span class="dot">.</span><span class="dot">.</span><span
              class="dot">.</span
            >
          </p>
        </div>

        <div class="verdict">
          <p class="out">OUT</p>
          <p class="decision">
            Decision: page not found. <span>Umpire's call is final.</span>
          </p>
        </div>
      </div>
    </div>

    <Pill hue="rose" size="lg" icon="🏏" href="/">Back to the pavilion</Pill>
  </div>
</Layout>

<style>
  .drs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
  }

  /* The stadium screen is dark in both themes. */
  .screen {
    --screen: #1b1b1c;
    --screen-text: #f7f1ff;
    --screen-muted: #bab6c0;
    --screen-line: #363537;
    --screen-orange: #fd9353;
    --screen-rose: #fc618d;

    width: 100%;
    overflow: hidden;
    border: 1px solid var(--screen-line);
    border-radius: 14px;
    background: var(--screen);
    color: var(--screen-text);
  }

  .strip {
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 1.3333rem;
    border-bottom: 1px solid var(--screen-line);
  }

  .strip .label {
    color: var(--screen-muted);
  }

  .stage {
    display: grid;
    min-height: clamp(18rem, 55vw, 26rem);
    padding: 2rem 1.3333rem;
  }

  .reviewing,
  .verdict {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.3333rem;
    text-align: center;
  }

  /* ------------------------------------------------------ Reviewing */

  .stumps {
    width: min(14rem, 50%);
    height: auto;
  }

  .track {
    stroke: var(--screen-orange);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
  }

  .wood {
    stroke: var(--screen-muted);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ball {
    fill: var(--screen-orange);
  }

  .status {
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--screen-orange);
  }

  .dot {
    animation: blink 0.9s infinite both;
  }

  .dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  .reviewing {
    animation: leave 0.4s ease 2.6s forwards;
  }

  /* ------------------------------------------------------- Verdict */

  .verdict {
    opacity: 0;
    animation: enter 0.5s ease 3s forwards;
  }

  .out {
    font-family: var(--font-serif);
    font-size: clamp(6rem, 24vw, 13rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--screen-rose);
  }

  .decision {
    max-width: 30rem;
    font-size: clamp(1.1333rem, 3vw, 1.4rem);
    line-height: 1.5;
  }

  .decision span {
    display: block;
    color: var(--screen-muted);
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes leave {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* No review theatre: go straight to the decision. */
  @media (prefers-reduced-motion: reduce) {
    .reviewing {
      display: none;
    }

    .verdict {
      opacity: 1;
      animation: none;
    }
  }
</style>
