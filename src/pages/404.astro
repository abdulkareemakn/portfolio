---
import Layout from "../layouts/Layout.astro";
import { Home } from "@lucide/astro";
---

<Layout
  title="404 — Abdul Kareem"
  description="The page you're looking for can't be found."
  noindex={true}
  showSidebar={false}
>
  <div class="container">
    <h1 class="headline">404</h1>
    <p class="exception">NullPointerException</p>
    <p class="message">The page you're looking for can't be found.</p>
    <a href="/" class="home-link">
      <Home class="icon" />
      Back Home
    </a>
  </div>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 55vh;
    text-align: center;
  }

  .headline {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    margin: 0 0 1.25rem;
    line-height: 1;
  }

  .exception {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }

  .message {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--text);
    margin: 0 0 2.25rem;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 4px;
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }

  .home-link .icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .home-link:hover,
  .home-link:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
