---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resume — Abdul Kareem">
  <div class="resume-toolbar">
    <h1 class="resume-title">Resume</h1>
    <button class="print-btn" type="button">Download PDF</button>
  </div>

  <article class="resume">
    <header class="resume-head">
      <h2>Abdul Kareem</h2>
      <p class="resume-contact">
        Lahore, Pakistan
        <span aria-hidden="true">|</span>
        <a href="mailto:abdulkareemakn@gmail.com">abdulkareemakn@gmail.com</a>
        <span aria-hidden="true">|</span>
        <a href="https://www.linkedin.com/in/abdul-kareem-nasir/">LinkedIn</a>
        <span aria-hidden="true">|</span>
        <a href="https://github.com/abdulkareemakn">GitHub</a>
      </p>
    </header>

    <section class="resume-section">
      <h3>Education</h3>
      <div class="resume-item">
        <div class="resume-item-head">
          <span class="resume-item-title">COMSATS University Islamabad</span>
          <span class="resume-item-date">Sep 2024 — Sep 2028</span>
        </div>
        <div class="resume-item-sub">
          <span>BS in Software Engineering</span>
          <span>Lahore, Pakistan</span>
        </div>
      </div>
      <div class="resume-item">
        <div class="resume-item-head">
          <span class="resume-item-title">Punjab Group of Colleges</span>
          <span class="resume-item-date">Aug 2022 — Aug 2024</span>
        </div>
        <div class="resume-item-sub">
          <span>Intermediate in Computer Science</span>
          <span>Lahore, Pakistan</span>
        </div>
      </div>
    </section>

    <section class="resume-section">
      <h3>Experience</h3>
      <div class="resume-item">
        <div class="resume-item-head">
          <span class="resume-item-title">Self-Hosted Infrastructure &amp; Homelab</span>
          <span class="resume-item-date">Jul 2025 — Present</span>
        </div>
        <div class="resume-item-sub">
          <span>Personal Project</span>
          <span>Lahore, Pakistan</span>
        </div>
        <ul class="resume-bullets">
          <li>
            Deployed and maintained various containerized services (Navidrome,
            Memos, OpenGist, Litestream) on a DigitalOcean VPS using Docker
            Compose.
          </li>
          <li>
            Configured Caddy as a reverse proxy with Cloudflare DNS, TLS
            termination, and authentication middleware via Auth0 for OIDC and
            Tinyauth for forward authentication.
          </li>
          <li>
            Provisioned a private Tailscale network (tailnet) to expose
            self-hosted services exclusively over an encrypted mesh VPN,
            eliminating public exposure for internal-only applications.
          </li>
        </ul>
      </div>
    </section>

    <section class="resume-section">
      <h3>Projects</h3>
      <div class="resume-item">
        <div class="resume-item-head">
          <span class="resume-item-title">Ayak</span>
          <span class="resume-item-date">2026 — Present</span>
        </div>
        <p class="resume-item-tech">TanStack Start, Cloudflare Workers, D1, R2</p>
        <ul class="resume-bullets">
          <li>
            Developed a full-stack e-commerce platform for a homemade jewelry
            store using TanStack Start, deployed on Cloudflare Workers.
          </li>
          <li>
            Designed a relational schema with Cloudflare D1 (SQLite) for
            products, orders, and payments, with Zod for end-to-end schema
            validation.
          </li>
          <li>
            Implemented bank-transfer payment verification workflow with
            proof-of-payment uploads stored via Cloudflare R2.
          </li>
          <li>
            Built authenticated checkout flow with email OTP-based
            authentication, eliminating password-related attack surfaces.
          </li>
        </ul>
      </div>
      <div class="resume-item">
        <div class="resume-item-head">
          <span class="resume-item-title">Orbit</span>
          <span class="resume-item-date">2026 — Present</span>
        </div>
        <p class="resume-item-tech">FastAPI, Vue 3, PostgreSQL</p>
        <ul class="resume-bullets">
          <li>
            Built a REST API with FastAPI enabling university students to track
            attendance, quiz, and assignment marks across courses.
          </li>
          <li>
            Designed and deployed a PostgreSQL database on Neon, with the API
            hosted on Render.
          </li>
          <li>
            Developed a Vue 3 single-page frontend application, deployed on
            Cloudflare Pages.
          </li>
          <li>Implemented Google OAuth for authentication, scoped to university accounts.</li>
        </ul>
      </div>
      <div class="resume-item">
        <div class="resume-item-head">
          <span class="resume-item-title">Personal Developer Blog</span>
          <span class="resume-item-date">2026 — Present</span>
        </div>
        <p class="resume-item-tech">Astro, Cloudflare Pages</p>
        <ul class="resume-bullets">
          <li>
            Built and deployed a personal blog using Astro on Cloudflare Pages,
            achieving a perfect 100 Lighthouse score.
          </li>
          <li>
            Configured a custom subdomain via CNAME DNS records to serve the
            site at abdulkareem.is-a.dev.
          </li>
          <li>
            Integrated Google Search Console for indexing and search performance
            monitoring.
          </li>
          <li>
            Actively publishing technical articles on self-hosting, Linux, and
            software development.
          </li>
        </ul>
      </div>
    </section>

    <section class="resume-section">
      <h3>Technical Skills</h3>
      <dl class="resume-skills">
        <dt>Programming Languages</dt>
        <dd>Python, C++, SQL (Postgres, SQLite, MSSQL), TypeScript, Go</dd>
        <dt>Markup</dt>
        <dd>HTML5, Markdown, Typst</dd>
        <dt>Frameworks</dt>
        <dd>Astro, FastAPI, Hono, React, TanStack Start, Tailwind CSS</dd>
        <dt>Infrastructure</dt>
        <dd>Cloudflare, Tailscale, Linux, Caddy</dd>
        <dt>Developer Tools</dt>
        <dd>Git, Docker &amp; Docker Compose, Bash</dd>
      </dl>
    </section>
  </article>

  <script>
    document.querySelector(".print-btn")?.addEventListener("click", () =>
      window.print(),
    );
  </script>
</Layout>

<style>
  .resume-toolbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .resume-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0;
  }

  .print-btn {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .print-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .resume {
    max-width: 42rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
  }

  .resume-head {
    border-bottom: 2px solid var(--border);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .resume-head h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.6rem;
    margin: 0 0 0.35rem;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
  }

  .resume-contact a {
    color: var(--accent);
    text-decoration: none;
  }

  .resume-contact a:hover {
    text-decoration: underline;
  }

  .resume-section {
    margin: 0 0 1.5rem;
  }

  .resume-section h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
  }

  .resume-item {
    margin: 0 0 1.1rem;
  }

  .resume-item-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-weight: 600;
  }

  .resume-item-date {
    font-weight: 400;
    color: var(--muted);
    white-space: nowrap;
  }

  .resume-item-sub {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-style: italic;
  }

  .resume-item-tech {
    margin: 0.1rem 0 0.25rem;
    color: var(--muted);
    font-style: italic;
    font-size: 0.9rem;
  }

  .resume-bullets {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }

  .resume-bullets li {
    margin: 0 0 0.25rem;
  }

  .resume-skills {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
  }

  .resume-skills dt {
    font-weight: 600;
  }

  .resume-skills dd {
    margin: 0;
  }

  @media print {
    .sidebar,
    .print-btn,
    .resume-toolbar {
      display: none !important;
    }

    body {
      max-width: none;
      padding: 0;
    }

    .content {
      padding-left: 0;
    }

    .resume {
      max-width: none;
      font-size: 11px;
    }

    .resume-head h2 {
      font-size: 1.4rem;
    }
  }
</style>
