---
import Layout from "../layouts/Layout.astro";

const itemClass = "mb-[1.1rem]";
const itemHeadClass = "flex items-baseline justify-between gap-4 font-semibold";
const dateClass = "font-normal whitespace-nowrap text-muted";
const subClass = "flex justify-between gap-4 text-muted italic";
const bulletsClass = "mt-[0.4rem] mb-0 list-disc pl-[1.1rem]";
---

<Layout
  title="Resume"
  description="Resume of Abdul Kareem: Software Engineering student at COMSATS Islamabad specializing in full-stack development and cloud edge infrastructure."
>
  <div class="mb-8 flex items-baseline justify-between gap-4 print:hidden">
    <h1 class="m-0 font-serif text-[clamp(1.75rem,4vw,2.25rem)] font-semibold">
      Resume
    </h1>
    <button
      class="print-btn min-h-12 cursor-pointer rounded-md border border-border bg-bg px-4 py-2 font-sans text-[0.85rem] text-text transition-colors hover:border-accent hover:text-accent"
      type="button">Download PDF</button
    >
  </div>

  <article class="text-[0.95rem] leading-[1.6] text-text print:text-[11px]">
    <header class="mb-6 border-b-2 border-border pb-4">
      <h2
        class="mb-[0.35rem] font-serif text-[1.6rem] font-semibold print:text-[1.4rem]"
      >
        Abdul Kareem
      </h2>
      <p class="m-0 flex flex-wrap gap-2 text-muted">
        Lahore, Pakistan
        <span aria-hidden="true">|</span>
        <a
          class="wrap-anywhere text-accent no-underline hover:underline"
          href="mailto:abdulkareemakn@proton.me">Email</a
        >
        <span aria-hidden="true">|</span>
        <a
          class="wrap-anywhere text-accent no-underline hover:underline"
          href="https://www.linkedin.com/in/abdul-kareem-nasir/">LinkedIn</a
        >
        <span aria-hidden="true">|</span>
        <a
          class="wrap-anywhere text-accent no-underline hover:underline"
          href="https://github.com/abdulkareemakn">GitHub</a
        >
      </p>
    </header>

    <section class="mb-6">
      <h3
        class="mb-3 border-b border-border pb-1 font-serif text-[1.05rem] font-semibold tracking-[0.08em] uppercase"
      >
        Education
      </h3>
      <div class={itemClass}>
        <div class={itemHeadClass}>
          <span>COMSATS University Islamabad</span>
          <span class={dateClass}>Sep 2024 — Sep 2028</span>
        </div>
        <div class={subClass}>
          <span>BS in Software Engineering</span>
          <span>Lahore, Pakistan</span>
        </div>
      </div>
      <div class={itemClass}>
        <div class={itemHeadClass}>
          <span>Punjab Group of Colleges</span>
          <span class={dateClass}>Aug 2022 — Aug 2024</span>
        </div>
        <div class={subClass}>
          <span>Intermediate in Computer Science</span>
          <span>Lahore, Pakistan</span>
        </div>
      </div>
    </section>

    <section class="mb-6">
      <h3
        class="mb-3 border-b border-border pb-1 font-serif text-[1.05rem] font-semibold tracking-[0.08em] uppercase"
      >
        Experience
      </h3>
      <div class={itemClass}>
        <div class={itemHeadClass}>
          <span>Self-Hosted Infrastructure &amp; Homelab</span>
          <span class={dateClass}>Jul 2025 — Present</span>
        </div>
        <div class={subClass}>
          <span>Personal Project</span>
          <span>Lahore, Pakistan</span>
        </div>
        <ul class={bulletsClass}>
          <li>
            Deployed and maintained various containerized services (Navidrome,
            Memos, OpenGist, Litestream) on a DigitalOcean VPS using Docker
            Compose.
          </li>
          <li>
            Configured Caddy as a reverse proxy with Cloudflare DNS, TLS
            termination, and authentication middleware via Auth0 for OIDC and
            Tinyauth for forward authentication.
          </li>
          <li>
            Provisioned a private Tailscale network (tailnet) to expose
            self-hosted services exclusively over an encrypted mesh VPN,
            eliminating public exposure for internal-only applications.
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-6">
      <h3
        class="mb-3 border-b border-border pb-1 font-serif text-[1.05rem] font-semibold tracking-[0.08em] uppercase"
      >
        Projects
      </h3>
      <div class={itemClass}>
        <div class={itemHeadClass}>
          <span>Ayak</span>
          <span class={dateClass}>2026 — Present</span>
        </div>
        <p class="mt-[0.1rem] mb-1 text-[0.9rem] text-muted italic">
          TanStack Start, Cloudflare Workers, D1, R2
        </p>
        <ul class={bulletsClass}>
          <li>
            Developed a full-stack e-commerce platform for a homemade jewelry
            store using TanStack Start, deployed on Cloudflare Workers.
          </li>
          <li>
            Designed a relational schema with Cloudflare D1 (SQLite) for
            products, orders, and payments, with Zod for end-to-end schema
            validation.
          </li>
          <li>
            Implemented bank-transfer payment verification workflow with
            proof-of-payment uploads stored via Cloudflare R2.
          </li>
          <li>
            Built authenticated checkout flow with email OTP-based
            authentication, eliminating password-related attack surfaces.
          </li>
        </ul>
      </div>
      <div class={itemClass}>
        <div class={itemHeadClass}>
          <span>Orbit</span>
          <span class={dateClass}>2026 — Present</span>
        </div>
        <p class="mt-[0.1rem] mb-1 text-[0.9rem] text-muted italic">
          FastAPI, Vue 3, PostgreSQL
        </p>
        <ul class={bulletsClass}>
          <li>
            Built a REST API with FastAPI enabling university students to track
            attendance, quiz, and assignment marks across courses.
          </li>
          <li>
            Designed and deployed a PostgreSQL database on Neon, with the API
            hosted on Render.
          </li>
          <li>
            Developed a Vue 3 single-page frontend application, deployed on
            Cloudflare Pages.
          </li>
          <li>
            Implemented Google OAuth for authentication, scoped to university
            accounts.
          </li>
        </ul>
      </div>
      <div class={itemClass}>
        <div class={itemHeadClass}>
          <span>Personal Developer Blog</span>
          <span class={dateClass}>2026 — Present</span>
        </div>
        <p class="mt-[0.1rem] mb-1 text-[0.9rem] text-muted italic">
          Astro, Cloudflare Pages
        </p>
        <ul class={bulletsClass}>
          <li>
            Built and deployed a personal blog using Astro on Cloudflare Pages,
            achieving a perfect 100 Lighthouse score.
          </li>
          <li>
            Configured a custom subdomain via CNAME DNS records to serve the
            site at abdulkareem.is-a.dev.
          </li>
          <li>
            Integrated Google Search Console for indexing and search performance
            monitoring.
          </li>
          <li>
            Actively publishing technical articles on self-hosting, Linux, and
            software development.
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-6">
      <h3
        class="mb-3 border-b border-border pb-1 font-serif text-[1.05rem] font-semibold tracking-[0.08em] uppercase"
      >
        Technical Skills
      </h3>
      <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
        <dt class="font-semibold">Programming Languages</dt>
        <dd class="m-0">
          Python, C++, SQL (Postgres, SQLite, MSSQL), TypeScript, Go
        </dd>
        <dt class="font-semibold">Markup</dt>
        <dd class="m-0">HTML5, Markdown, Typst</dd>
        <dt class="font-semibold">Frameworks</dt>
        <dd class="m-0">
          Astro, FastAPI, Hono, React, TanStack Start, Tailwind CSS
        </dd>
        <dt class="font-semibold">Infrastructure</dt>
        <dd class="m-0">Cloudflare, Tailscale, Linux, Caddy</dd>
        <dt class="font-semibold">Developer Tools</dt>
        <dd class="m-0">Git, Docker &amp; Docker Compose, Bash</dd>
      </dl>
    </section>
  </article>

  <script>
    document
      .querySelector(".print-btn")
      ?.addEventListener("click", () => window.print());
  </script>
</Layout>
