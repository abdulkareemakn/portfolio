---
import Layout from "../layouts/Layout.astro";
import HomeProjectsPreview from "../components/HomeProjectsPreview.astro";
---

<Layout
  title="Projects - Abdul Kareem"
  description="Selected full-stack applications built by Abdul Kareem with Cloudflare Workers, TanStack Start, React, and modern web technologies."
>
  <header class="projects-header">
    <h1>Projects</h1>
    <p>Selected products I have designed, built, and shipped.</p>
  </header>

  <HomeProjectsPreview />
</Layout>

<style>
  .projects-header {
    max-width: 38rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
