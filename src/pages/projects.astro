---
import Layout from "../layouts/Layout.astro";

interface Project {
  name: string;
  date: string;
  tech: string;
  description: string;
  bullets: string[];
  links?: { label: string; href: string }[];
}

const projects: Project[] = [
  {
    name: "Ayak",
    date: "2026 — Present",
    tech: "TanStack Start, Cloudflare Workers, D1, R2",
    description:
      "A full-stack ecommerce platform for a homemade jewelry store.",
    bullets: [
      "Relational schema on Cloudflare D1 (SQLite) for products, orders, and payments, with Zod for end-to-end schema validation.",
      "Bank-transfer payment verification workflow with proof-of-payment uploads stored via Cloudflare R2.",
      "Authenticated checkout flow with email OTP-based authentication, eliminating password-related attack surfaces.",
    ],
    links: [
      { label: "ayak.abdulkareemakn.workers.dev", href: "https://ayak.abdulkareemakn.workers.dev" },
    ],
  },
  {
    name: "Orbit",
    date: "2026 — Present",
    tech: "FastAPI, Vue 3, PostgreSQL",
    description:
      "An attendance tracker for university courses.",
    bullets: [
      "REST API with FastAPI letting students track attendance, quiz, and assignment marks across courses.",
      "PostgreSQL database on Neon, with the API hosted on Render.",
      "Vue 3 single-page frontend deployed on Cloudflare Pages.",
      "Google OAuth authentication, scoped to university accounts.",
    ],
    links: [
      { label: "orbit-egw.pages.dev", href: "https://orbit-egw.pages.dev" },
    ],
  },
  {
    name: "Personal Developer Blog",
    date: "2026 — Present",
    tech: "Astro, Cloudflare Pages",
    description:
      "A blog on self-hosting, Linux, and software development.",
    bullets: [
      "Built with Astro on Cloudflare Pages, achieving a perfect 100 Lighthouse score.",
      "Custom subdomain via CNAME DNS records.",
      "Google Search Console integration for indexing and search performance monitoring.",
    ],
    links: [
      { label: "abdulkareem.is-a.dev", href: "https://abdulkareem.is-a.dev" },
    ],
  },
  {
    name: "This Portfolio",
    date: "2026 — Present",
    tech: "Astro, Cloudflare Pages",
    description:
      "The site you're reading — a static Astro site with live Lichess and AUR status, a GitHub contribution graph, and a print-friendly resume.",
    bullets: [
      "Static-first with zero runtime JavaScript outside of the small status and theme scripts.",
      "Live status hydration for Lichess rating and AUR package count.",
    ],
    links: [
      { label: "GitHub — abdulkareemakn", href: "https://github.com/abdulkareemakn" },
    ],
  },
];
---

<Layout title="Projects — Abdul Kareem">
  <article class="projects">
    <h1 class="projects-title">Projects</h1>
    <p class="projects-intro">
      A selection of things I've built. Live links where they exist.
    </p>

    {projects.map((p) => (
      <section class="project">
        <div class="project-head">
          <h2 class="project-name">{p.name}</h2>
          <span class="project-date">{p.date}</span>
        </div>
        <p class="project-tech">{p.tech}</p>
        <p class="project-desc">{p.description}</p>
        <ul class="project-bullets">
          {p.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
        {p.links && (
          <ul class="project-links">
            {p.links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noreferrer">
                  {l.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </article>
</Layout>

<style>
  .projects {
    max-width: 42rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
  }

  .projects-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 1rem;
  }

  .projects-intro {
    color: var(--muted);
    margin: 0 0 2.5rem;
  }

  .project {
    margin: 0 0 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .project:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .project-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    margin: 0;
  }

  .project-date {
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .project-tech {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0.35rem 0 0.75rem;
  }

  .project-desc {
    margin: 0 0 0.75rem;
  }

  .project-bullets {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }

  .project-bullets li {
    margin: 0 0 0.4rem;
  }

  .project-links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .project-links a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.15rem;
    transition: border-color 0.15s ease;
  }

  .project-links a:hover,
  .project-links a:focus-visible {
    border-color: var(--accent);
  }
</style>
