---
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
---

<Layout
  title="Projects — Abdul Kareem"
  description="Selected full-stack applications built by Abdul Kareem with Cloudflare Workers, TanStack Start, React, and modern web technologies."
  hue="blue"
>
  <header class="head">
    <h1 class="page-title">Projects</h1>
    <p class="lead">Selected products I have designed, built, and shipped.</p>
  </header>

  <ProjectList />
</Layout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 38rem;
    margin-bottom: 2.6667rem;
  }

  .lead {
    color: var(--muted);
  }
</style>
