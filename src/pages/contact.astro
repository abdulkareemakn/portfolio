---
import Layout from "../layouts/Layout.astro";
import Socials from "../components/Socials.astro";
---

<Layout title="Contact — Abdul Kareem">
  <article class="contact">
    <h1 class="contact-title">Contact</h1>
    <p class="contact-intro">
      I'm always up for talking about software, self-hosting, or open source.
      If you have a question, an idea, or an opportunity, drop me a line.
    </p>

    <a class="contact-email" href="mailto:abdulkareemakn@gmail.com">
      abdulkareemakn@gmail.com
    </a>

    <div class="contact-socials">
      <h2 class="contact-subtitle">Elsewhere</h2>
      <Socials />
    </div>
  </article>
</Layout>

<style>
  .contact {
    max-width: 42rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
  }

  .contact-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 1rem;
  }

  .contact-intro {
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .contact-email {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.2rem;
    margin-bottom: 2.5rem;
    transition: border-color 0.15s ease;
  }

  .contact-email:hover,
  .contact-email:focus-visible {
    border-color: var(--accent);
  }

  .contact-subtitle {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
  }

  .contact-email {
    overflow-wrap: anywhere;
  }
</style>
